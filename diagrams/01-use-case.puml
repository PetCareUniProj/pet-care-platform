@startuml Use Case Diagram - Pet Connect
' Global settings
skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 11
skinparam defaultFontName Arial

' Vertical orientation
top to bottom direction

' USE_CASE_THEME styling
skinparam actor {
    BackgroundColor #E6F3FF
    BorderColor #0066CC
}
skinparam usecase {
    BackgroundColor #CCE5FF
    BorderColor #0066CC
    FontSize 10
}
skinparam rectangle {
    BackgroundColor #B3D9FF
    BorderColor #004499
}

' Actors - single column at top
actor "Гість" as Guest
actor "Клієнт" as Client
actor "Власник тварини\n(Mobile)" as MobileUser
actor "Менеджер" as Manager
actor "Адміністратор" as Admin

' Actor generalization
Client <|-- MobileUser : <<extends>>
Manager <|-- Admin : <<extends>>

' Section 1: Web Site - Guest Functions
rectangle "Веб-сайт:\nПублічні функції" as WebGuest {
    usecase "Головна сторінка" as UC1
    usecase "Каталог товарів" as UC2
    usecase "Пошук товарів" as UC3
    usecase "Фільтрація" as UC4
    usecase "Деталі товару" as UC5
    usecase "Додати до кошика" as UC6
}

' Section 2: Web Site - Client Functions
rectangle "Веб-сайт:\nОсобистий кабінет" as WebClient {
    usecase "Зареєструватися" as UC7
    usecase "Увійти" as UC8
    usecase "Відновити пароль" as UC9
    usecase "Оформити замовлення" as UC10
    usecase "Історія замовлень" as UC11
    usecase "Статус замовлення" as UC12
    usecase "Залишити відгук" as UC13
    usecase "Редагувати профіль" as UC14
}

' Section 3: Mobile App
rectangle "Мобільний\nзастосунок" as MobileApp {
    usecase "Створити профіль\nтварини" as UC15
    usecase "Редагувати профіль" as UC16
    usecase "Видалити профіль" as UC17
    usecase "Перемикатися\nміж профілями" as UC18
    usecase "Створити нагадування" as UC19
    usecase "Переглянути календар" as UC20
    usecase "Push-сповіщення" as UC21
    usecase "Замовити з\nнагадування" as UC22
    usecase "Налаштувати підписку" as UC23
    usecase "Керувати підписками" as UC24
}

' Section 4: Admin Panel - Manager
rectangle "Адмін-панель:\nМенеджер" as AdminManager {
    usecase "Увійти в адмін-\nпанель" as UC25
    usecase "Додати товар" as UC26
    usecase "Редагувати товар" as UC27
    usecase "Видалити товар" as UC28
    usecase "Керувати\nкатегоріями" as UC29
    usecase "Керувати брендами" as UC30
    usecase "Оновити залишки" as UC31
    usecase "Переглянути\nзамовлення" as UC32
    usecase "Змінити статус" as UC33
    usecase "Обробити\nповернення" as UC34
}

' Section 5: Admin Panel - Administrator
rectangle "Адмін-панель:\nАдміністратор" as AdminAdmin {
    usecase "Створити обліковий\nзапис менеджера" as UC35
    usecase "Редагувати права" as UC36
    usecase "Деактивувати\nобліковий запис" as UC37
    usecase "Переглянути\nаналітику" as UC38
    usecase "Генерувати звіти" as UC39
}

' Relationships - Guest (only WebGuest section)
Guest --> UC1
Guest --> UC2
Guest --> UC3
Guest --> UC4
Guest --> UC5
Guest --> UC6

' Relationships - Client (only WebClient section)
Client --> UC7
Client --> UC8
Client --> UC9
Client --> UC10
Client --> UC11
Client --> UC12
Client --> UC13
Client --> UC14

' Relationships - Mobile User (only MobileApp section)
MobileUser --> UC15
MobileUser --> UC16
MobileUser --> UC17
MobileUser --> UC18
MobileUser --> UC19
MobileUser --> UC20
MobileUser --> UC21
MobileUser --> UC22
MobileUser --> UC23
MobileUser --> UC24

' Relationships - Manager (only AdminManager section)
Manager --> UC25
Manager --> UC26
Manager --> UC27
Manager --> UC28
Manager --> UC29
Manager --> UC30
Manager --> UC31
Manager --> UC32
Manager --> UC33
Manager --> UC34

' Relationships - Admin (only AdminAdmin section - inherits Manager through generalization)
Admin --> UC35
Admin --> UC36
Admin --> UC37
Admin --> UC38
Admin --> UC39

' Include relationships
UC10 ..> UC6 : <<include>>
UC10 ..> UC8 : <<include>>
UC22 ..> UC10 : <<include>>

' Extend relationships
UC13 ..> UC11 : <<extend>>

@enduml