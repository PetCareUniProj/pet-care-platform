@startuml Statechart Diagram - Basket Lifecycle
' Global settings
skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 11
skinparam defaultFontName Arial

' STATECHART_THEME styling
skinparam state {
    BackgroundColor #FFF0E6
    BorderColor #FF6600
}

[*] --> BasketEmpty : Створення кошика

state BasketEmpty as "Порожній\n(Empty)" : Кошик створено,\nтоварів немає

state BasketWithItems as "З товарами\n(With Items)" : Кошик містить\nодин або більше товарів

state BasketLocked as "Заблокований\n(Locked)" : Кошик заблокований\nдля оформлення замовлення

state BasketConverted as "Конвертований\n(Converted)" : Кошик конвертовано\nв замовлення

state BasketAbandoned as "Покинутий\n(Abandoned)" : Кошик не використовувався\nпонад 7 днів

BasketEmpty --> BasketWithItems : addItem()\n[додано товар]

BasketWithItems --> BasketEmpty : removeAllItems()\n[видалено всі товари]

BasketWithItems --> BasketWithItems : addItem()\n[додано ще товар]

BasketWithItems --> BasketWithItems : updateQuantity()\n[змінено кількість]

BasketWithItems --> BasketWithItems : removeItem()\n[видалено товар]

BasketWithItems --> BasketLocked : lockForCheckout()\n[початок оформлення]

BasketLocked --> BasketWithItems : unlock()\n[скасовано оформлення]

BasketLocked --> BasketConverted : convertToOrder()\n[створено замовлення]

BasketWithItems --> BasketAbandoned : markAbandoned()\n[7+ днів бездіяльності]

BasketAbandoned --> BasketWithItems : restore()\n[користувач повернувся]

BasketConverted --> [*] : Очищення кошика

BasketAbandoned --> [*] : Очищення кошика

note right of BasketEmpty
    **Початковий стан:**
    Кошик створено,
    але ще не містить товарів
end note

note right of BasketWithItems
    **Основний робочий стан:**
    Користувач додає та
    редагує товари
end note

note right of BasketLocked
    **Захищений стан:**
    Кошик заблокований
    під час оформлення,
    щоб запобігти змінам
end note

note right of BasketConverted
    **Фінальний стан:**
    Кошик успішно
    конвертовано в замовлення,
    після чого він очищується
end note

note right of BasketAbandoned
    **Тимчасовий стан:**
    Кошик не використовувався
    довгий час, але може
    бути відновлений
end note

@enduml

