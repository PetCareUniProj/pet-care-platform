@startuml Statechart Diagram - Order States
' Global settings
skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 11
skinparam defaultFontName Arial

' Vertical orientation for all diagrams
top to bottom direction

' Common styling for notes
skinparam note {
    BackgroundColor #FFFACD
    BorderColor #FFD700
    BorderThickness 1
}

' STATE_THEME styling
skinparam state {
    BackgroundColor #FFE6CC
    BorderColor #FF6600
}
skinparam state<<start>> {
    BackgroundColor #FFCC99
    BorderColor #CC4400
}
skinparam state<<end>> {
    BackgroundColor #FFB366
    BorderColor #AA3300
}

' Start state
[*] --> Draft : Create Order

' Main order states
state Draft as "Draft\n(Чернетка)" : Замовлення створено\nале не підтверджено
state Submitted as "Submitted\n(Подано)" : Замовлення підтверджено\nочікує обробки
state AwaitingValidation as "AwaitingValidation\n(Очікує валідації)" : Перевіряється наявність\nтоварів на складі
state StockConfirmed as "StockConfirmed\n(Запаси підтверджені)" : Товари зарезервовані\nна складі
state Paid as "Paid\n(Оплачено)" : Оплата отримана
state Shipped as "Shipped\n(Відправлено)" : Замовлення відправлено\nпокупцеві
state Cancelled as "Cancelled\n(Скасовано)" : Замовлення скасовано

' Transitions between states
Draft --> Submitted : submitOrder()\n[користувач підтверджує]
Submitted --> AwaitingValidation : startValidation()\n[автоматично після подання]

AwaitingValidation --> StockConfirmed : confirmStock()\n[всі товари в наявності]
AwaitingValidation --> Cancelled : stockRejected()\n[недостатньо товарів]

StockConfirmed --> Paid : processPayment()\n[успішна оплата]
StockConfirmed --> Cancelled : cancelOrder()\n[до оплати]

Paid --> Shipped : shipOrder()\n[замовлення відправлено]
Paid --> Cancelled : cancelOrder()\n[перед відправкою]

Shipped --> [*] : deliverOrder()\n[товар доставлено]

' Cancellation paths
Draft --> Cancelled : cancelDraft()\n[користувач скасовує]
Submitted --> Cancelled : cancelOrder()\n[до валідації]
Cancelled --> [*] : orderClosed()\n[замовлення закрито]

' Notes
note right of Draft
    **Початковий стан:**
    Замовлення створено,
    але не готове до обробки
end note

note right of AwaitingValidation
    **Критичний стан:**
    Перевірка запасів -
    можливе скасування
    при недостатніх запасах
end note

note right of StockConfirmed
    **Підготовлений стан:**
    Товари зарезервовані,
    очікується оплата
end note

note right of Paid
    **Фінансовий стан:**
    Оплата підтверджена,
    можна відправляти товар
end note

note right of Cancelled
    **Кінцевий стан:**
    Замовлення скасовано,
    кошти повернуті
end note

== Стани профілю тварини ==

[*] --> PetDraft : Створити профіль

state PetDraft as "Чернетка\n(Draft)" : Профіль створено,\nале не заповнено
state PetActive as "Активний\n(Active)" : Профіль повністю\nзаповнений та активний
state PetInactive as "Неактивний\n(Inactive)" : Профіль тимчасово\nвимкнений
state PetArchived as "Архівний\n(Archived)" : Профіль видалено\nабо архівовано

PetDraft --> PetActive : completeProfile()\n[всі дані введені]
PetActive --> PetInactive : deactivateProfile()\n[власник вимкнув]
PetInactive --> PetActive : activateProfile()\n[власник увімкнув]
PetActive --> PetArchived : deleteProfile()\n[остаточне видалення]
PetInactive --> PetArchived : deleteProfile()\n[остаточне видалення]

note right of PetDraft
    **Початковий стан профілю:**
    Потрібно заповнити всі поля
end note

note right of PetActive
    **Робочий стан:**
    Профіль використовується
    для нагадувань та замовлень
end note

== Стани підписки на товари ==

[*] --> SubscriptionCreated : Створити підписку

state SubscriptionCreated as "Створена\n(Created)" : Підписка налаштована,\nале не активна
state SubscriptionActive as "Активна\n(Active)" : Підписка працює,\nавтоматичні замовлення
state SubscriptionPaused as "Призупинена\n(Paused)" : Тимчасово зупинена\nвласником
state SubscriptionCancelled as "Скасована\n(Cancelled)" : Підписка припинена

SubscriptionCreated --> SubscriptionActive : activateSubscription()\n[перша оплата успішна]
SubscriptionActive --> SubscriptionPaused : pauseSubscription()\n[власник призупинив]
SubscriptionPaused --> SubscriptionActive : resumeSubscription()\n[власник відновив]
SubscriptionActive --> SubscriptionCancelled : cancelSubscription()\n[остаточне скасування]
SubscriptionPaused --> SubscriptionCancelled : cancelSubscription()\n[остаточне скасування]

note right of SubscriptionActive
    **Основний стан:**
    Автоматичні замовлення
    та доставки активні
end note

note right of SubscriptionPaused
    **Тимчасовий стан:**
    Замовлення не надходять,
    але підписка зберігається
end note

@enduml
