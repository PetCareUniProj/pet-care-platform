@startuml Activity Diagram - User Authentication Process
' Global settings
skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 11
skinparam defaultFontName Arial

' ACTIVITY_THEME styling
skinparam activity {
    BackgroundColor #F2E6FF
    BorderColor #9900CC
}
skinparam activityDiamond {
    BackgroundColor #E6CCFF
    BorderColor #770099
}

start

:Користувач відкриває форму входу;

:Ввести email/логін;
:Ввести пароль;

:Натиснути кнопку "Увійти";

:Перевірка валідності даних;

if (Дані валідні?) then (ні)
    :Показати помилку валідації;
    stop
else (так)
endif

:Відправити запит до Keycloak;

:Keycloak перевіряє облікові дані;

if (Облікові дані правильні?) then (ні)
    :Keycloak повертає помилку;
    :Показати повідомлення "Невірний логін або пароль";
    stop
else (так)
endif

:Keycloak генерує JWT токен;
:Keycloak повертає токен та refresh token;

:Зберегти токен на клієнті;
:Встановити сесію користувача;

if (Роль користувача?) then (Клієнт)
    :Перенаправити на головну сторінку;
elseif (Менеджер) then
    :Перенаправити на адмін-панель;
elseif (Адміністратор) then
    :Перенаправити на адмін-панель;
else (інша)
    :Перенаправити на головну сторінку;
endif

:Показати особистий кабінет;

stop

@enduml

