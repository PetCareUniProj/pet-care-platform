@startuml Activity Diagram - Catalog Management Process
' Global settings
skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 11
skinparam defaultFontName Arial

' Common styling for notes
skinparam note {
    BackgroundColor #FFFACD
    BorderColor #FFD700
    BorderThickness 1
}

' ACTIVITY_THEME styling
skinparam activity {
    BackgroundColor #F2E6FF
    BorderColor #9900CC
}
skinparam activityDiamond {
    BackgroundColor #E6CCFF
    BorderColor #770099
}

start

:Увійти в адмін-панель;
:Перейти до розділу "Каталог";

if (Що робити?) then (додати товар)
    :Натиснути "Додати товар";

    :Заповнити назву товару;
    :Вибрати категорію;
    :Вибрати бренд;
    :Додати опис товару;
    :Встановити ціну;

    if (Є фото?) then (так)
        :Завантажити фото товару;
    endif

    :Встановити кількість на складі;
    :Позначити як "активний";
    :Зберегти товар;

elseif (редагувати товар)
    :Вибрати товар зі списку;
    :Натиснути "Редагувати";
    :Змінити назву/опис/ціну;
    :Оновити кількість;

    if (Змінити фото?) then (так)
        :Завантажити нове фото;
    endif

    :Зберегти зміни;

elseif (видалити товар)
    :Вибрати товар;
    :Натиснути "Видалити";

    if (Товар продавався?) then (так)
        :Позначити як "неактивний";
    else (ні)
        :Повністю видалити товар;
    endif

elseif (керувати категоріями)
    :Перейти до категорій;
    :Додати нову категорію/бренд;
    :Редагувати існуючу;
    :Змінити порядок відображення;
    :Зберегти зміни;

elseif (керувати брендами)
    :Перейти до брендів;
    :Додати нову категорію/бренд;
    :Редагувати існуючу;
    :Змінити порядок відображення;
    :Зберегти зміни;
endif

:Перевірити обов'язкові поля;
:Валідувати формат даних;
:Зберегти в базу даних;
:Очистити кеш;

:Показати повідомлення успіху;
:Повернутися до списку товарів;

stop

@enduml
