@startuml Activity Diagram - Order Checkout Process
' Global settings
skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 11
skinparam defaultFontName Arial

' Common styling for notes
skinparam note {
    BackgroundColor #FFFACD
    BorderColor #FFD700
    BorderThickness 1
}

' ACTIVITY_THEME styling
skinparam activity {
    BackgroundColor #F2E6FF
    BorderColor #9900CC
}
skinparam activityDiamond {
    BackgroundColor #E6CCFF
    BorderColor #770099
}

start

:Переглянути каталог товарів;
:Вибрати товар;
:Додати товар до кошика;

:Переглянути кошик;
:Змінити кількість товарів;

if (Кошик порожній?) then (так)
    :Повернутися до покупок;
    stop
else (ні)
    :Перейти до оформлення;
endif

if (Користувач авторизований?) then (так)
    :Продовжити оформлення;
else (ні)
    :Показати форму входу/реєстрації;
    :Ввести дані;
    :Підтвердити авторизацію;
endif

:Вибрати спосіб доставки;
:Ввести адресу доставки;
:Підтвердити дані доставки;

:Вибрати спосіб оплати;
:Ввести платіжні дані;
:Підтвердити оплату;

:Валідувати замовлення;
:Забронювати товар на складі;
:Створити запис замовлення;
:Надіслати підтвердження;

:Показати підтвердження замовлення;
:Надіслати email з деталями;

stop

@enduml
