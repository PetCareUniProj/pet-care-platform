@startuml Activity Diagram - Password Recovery Process
' Global settings
skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 11
skinparam defaultFontName Arial

' ACTIVITY_THEME styling
skinparam activity {
    BackgroundColor #F2E6FF
    BorderColor #9900CC
}
skinparam activityDiamond {
    BackgroundColor #E6CCFF
    BorderColor #770099
}

start

:Користувач натискає "Забули пароль?";

:Ввести email;

:Натиснути "Відправити";

:Перевірка валідності email;

if (Email валідний?) then (ні)
    :Показати помилку валідації;
    stop
else (так)
endif

:Перевірити наявність користувача в системі;

if (Користувач існує?) then (ні)
    :Показати повідомлення про відправку;
    :Не розкривати інформацію про наявність email;
    stop
else (так)
endif

:Keycloak генерує токен скидання паролю;
:Keycloak генерує посилання для скидання;
:Відправити email з посиланням;

:Показати повідомлення про відправку email;

stop

partition "Користувач отримує email" {
    start
    :Користувач відкриває email;
    :Натискає на посилання для скидання;
    :Перехід на сторінку встановлення нового паролю;
    stop
}

partition "Встановлення нового паролю" {
    start
    :Відкрити форму встановлення нового паролю;
    
    :Перевірити токен скидання;
    
    if (Токен валідний?) then (ні)
        :Показати помилку "Посилання недійсне";
        stop
    else (так)
    endif
    
    if (Токен не прострочений?) then (ні)
        :Показати помилку "Посилання прострочене";
        stop
    else (так)
    endif
    
    :Ввести новий пароль;
    :Підтвердити новий пароль;
    
    :Перевірка валідності паролю;
    
    if (Пароль валідний?) then (ні)
        :Показати помилку валідації;
        stop
    else (так)
    endif
    
    if (Паролі співпадають?) then (ні)
        :Показати помилку "Паролі не співпадають";
        stop
    else (так)
    endif
    
    :Keycloak хешує новий пароль;
    :Keycloak оновлює пароль в базі;
    :Keycloak інвалідує токен скидання;
    
    :Показати повідомлення про успіх;
    :Перенаправити на сторінку входу;
    
    stop
}

@enduml

