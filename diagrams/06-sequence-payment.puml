@startuml Sequence Diagram - Payment Processing
' Global settings
skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 11
skinparam defaultFontName Arial

' SEQUENCE_THEME styling
skinparam participant {
    BackgroundColor #E6FFE6
    BorderColor #00AA00
}
skinparam actor {
    BackgroundColor #E6F3FF
    BorderColor #0066CC
}

actor "Клієнт" as Client
participant "StoreWeb" as Web
participant "OrderingAPI" as OrderAPI
participant "PaymentService" as PaymentSvc
participant "LiqPay Gateway" as LiqPay
database "PostgreSQL" as DB
participant "RabbitMQ" as EventBus

Client -> Web: Натиснути "Оплатити"
activate Web

Web -> OrderAPI: initiatePayment(orderId)
activate OrderAPI

OrderAPI -> DB: GetOrderById(orderId)
activate DB
DB --> OrderAPI: Order data
deactivate DB

OrderAPI -> OrderAPI: Validate order status
OrderAPI -> OrderAPI: Calculate total amount

OrderAPI -> PaymentSvc: createPaymentRequest(orderId, amount)
activate PaymentSvc

PaymentSvc -> PaymentSvc: Generate payment ID
PaymentSvc -> PaymentSvc: Prepare payment data

PaymentSvc -> LiqPay: Create payment request
activate LiqPay
note right of LiqPay
    HTTPS POST request
    with payment details
end note

LiqPay -> LiqPay: Validate request
LiqPay -> LiqPay: Generate payment URL

LiqPay --> PaymentSvc: Return payment URL & signature
deactivate LiqPay

PaymentSvc -> DB: Save payment record
activate DB
DB --> PaymentSvc: Payment saved
deactivate DB

PaymentSvc --> OrderAPI: paymentUrl, paymentId
deactivate PaymentSvc

OrderAPI -> DB: UpdateOrderStatus(orderId, AwaitingPayment)
activate DB
DB --> OrderAPI: Updated
deactivate DB

OrderAPI --> Web: paymentUrl, paymentId
deactivate OrderAPI

Web --> Client: Redirect to payment page
deactivate Web

Client -> LiqPay: Enter payment details
activate LiqPay
note right of LiqPay
    User enters card details
    on LiqPay secure page
end note

Client -> LiqPay: Submit payment
LiqPay -> LiqPay: Process payment
LiqPay -> LiqPay: Verify card details
LiqPay -> LiqPay: Process transaction

alt Payment successful
    LiqPay -> PaymentSvc: Payment callback (success)
    activate PaymentSvc
    note right of PaymentSvc
        HTTPS callback from LiqPay
        with payment status
    end note
    
    PaymentSvc -> PaymentSvc: Verify callback signature
    PaymentSvc -> DB: UpdatePaymentStatus(paymentId, Paid)
    activate DB
    DB --> PaymentSvc: Updated
    deactivate DB
    
    PaymentSvc -> OrderAPI: notifyPaymentSuccess(orderId, paymentId)
    activate OrderAPI
    
    OrderAPI -> DB: UpdateOrderStatus(orderId, Paid)
    activate DB
    DB --> OrderAPI: Updated
    deactivate DB
    
    OrderAPI -> EventBus: Publish OrderPaid event
    activate EventBus
    EventBus --> OrderAPI: Published
    deactivate EventBus
    
    OrderAPI --> PaymentSvc: Order updated
    deactivate OrderAPI
    
    PaymentSvc --> LiqPay: Acknowledge callback
    deactivate PaymentSvc
    
    LiqPay --> Client: Redirect to success page
    deactivate LiqPay
    
    Client -> Web: Return to success page
    activate Web
    Web -> OrderAPI: GetOrderStatus(orderId)
    activate OrderAPI
    OrderAPI -> DB: GetOrder(orderId)
    activate DB
    DB --> OrderAPI: Order data
    deactivate DB
    OrderAPI --> Web: Order status: Paid
    deactivate OrderAPI
    Web --> Client: Show success message
    deactivate Web

else Payment failed
    LiqPay -> PaymentSvc: Payment callback (failed)
    activate PaymentSvc
    
    PaymentSvc -> PaymentSvc: Verify callback signature
    PaymentSvc -> DB: UpdatePaymentStatus(paymentId, Failed)
    activate DB
    DB --> PaymentSvc: Updated
    deactivate DB
    
    PaymentSvc -> OrderAPI: notifyPaymentFailure(orderId, paymentId)
    activate OrderAPI
    
    OrderAPI -> DB: UpdateOrderStatus(orderId, PaymentFailed)
    activate DB
    DB --> OrderAPI: Updated
    deactivate DB
    
    OrderAPI --> PaymentSvc: Order updated
    deactivate OrderAPI
    
    PaymentSvc --> LiqPay: Acknowledge callback
    deactivate PaymentSvc
    
    LiqPay --> Client: Redirect to failure page
    deactivate LiqPay
    
    Client -> Web: Return to failure page
    activate Web
    Web --> Client: Show error message
    deactivate Web
end

@enduml

