@startuml Sequence Diagram - Subscription Setup Flow
' Global settings
skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 11
skinparam defaultFontName Arial

' Sequence diagrams are vertical by default

' Common styling for participants
skinparam participant {
    BackgroundColor White
    BorderColor Black
    BorderThickness 2
}

' Common styling for notes
skinparam note {
    BackgroundColor #FFFACD
    BorderColor #FFD700
    BorderThickness 1
}

' SEQUENCE_THEME styling
skinparam sequenceParticipant {
    BackgroundColor #FFE6FF
    BorderColor #CC00CC
}
skinparam sequenceLifeLine {
    BorderColor #CC00CC
}
skinparam sequenceArrow {
    Color #990099
}

actor "Клієнт\n(Власник тварини)" as Client
participant "Мобільний\nзастосунок" as MobileApp
participant "Subscription\nController" as Controller
participant "Subscription\nAPI\n(NestJS)" as SubscriptionApi
participant "Catalog\nAPI\n(.NET)" as CatalogApi
participant "RabbitMQ\n(Event Bus)" as RabbitMQ
participant "Payment\nProcessor\n(.NET)" as PaymentProcessor
database "PostgreSQL\n(Database)" as DB

== Налаштування підписки на корм ==

Client -> MobileApp: 1: startSubscriptionSetup()
activate MobileApp

MobileApp -> Controller: 2: requestSubscriptionOptions(userId)
activate Controller

Controller -> CatalogApi: 3: getAvailableProducts(type=feed)
activate CatalogApi

CatalogApi -> DB: 3.1: select * from Products where isSubscribable = true
activate DB
DB --> CatalogApi: 3.2: return: ProductList
deactivate DB

CatalogApi --> Controller: 4: return: ProductList
deactivate CatalogApi

Controller --> MobileApp: 5: displaySetupForm(ProductList)
deactivate Controller

MobileApp --> Client: Відображення форми вибору товарів
note right: Клієнт обирає корм, частоту доставки та адресу

Client -> MobileApp: 6: submitSubscription(productId, frequency, address)
MobileApp -> Controller: 7: processNewSubscription(data)
activate Controller

Controller -> SubscriptionApi: 8: saveSubscription(data)
activate SubscriptionApi

SubscriptionApi -> DB: 8.1: insert into Subscriptions (data)
activate DB
DB --> SubscriptionApi: 8.2: return: subscriptionId
deactivate DB

SubscriptionApi --> Controller: 9: return: Success
deactivate SubscriptionApi

Controller --> MobileApp: 10: return: Confirmation
deactivate Controller

MobileApp --> Client: 11: displaySuccessMessage()
deactivate MobileApp

== Асинхронна ініціація першого платежу ==

SubscriptionApi -> RabbitMQ: 12: publish: PaymentNeeded(subscriptionId)
activate RabbitMQ

RabbitMQ -> PaymentProcessor: 13: consume: PaymentNeeded(subscriptionId)
activate PaymentProcessor

PaymentProcessor -> PaymentProcessor: 13.1: processInitialPayment(subscriptionId)

alt Оплата успішна
    PaymentProcessor -> SubscriptionApi: 13.2: paymentCompleted(subscriptionId)
    SubscriptionApi -> DB: 13.3: UPDATE subscription status (Active)
    DB --> SubscriptionApi: Status updated
    SubscriptionApi --> PaymentProcessor: OK
else Помилка оплати
    PaymentProcessor -> SubscriptionApi: 13.4: paymentFailed(subscriptionId)
    SubscriptionApi -> DB: 13.5: UPDATE subscription status (PendingPayment)
    DB --> SubscriptionApi: Status updated
    SubscriptionApi --> PaymentProcessor: Notification sent to client
end

deactivate PaymentProcessor
deactivate RabbitMQ

@enduml
