@startuml Component Diagram - Pet Connect Microservices
' Global settings
skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 11
skinparam defaultFontName Arial

' Vertical orientation
top to bottom direction

' COMPONENT_THEME styling
skinparam component {
    BackgroundColor #FFE6F2
    BorderColor #FF1493
    BorderThickness 2
}

skinparam rectangle {
    BackgroundColor #F0F8FF
    BorderColor #4682B4
    BorderThickness 2
}

skinparam arrow {
    Color #1E3A5F
    Thickness 2
}

' Client Layer
rectangle "Client Layer" {
    component [Mobile App\nReact Native] as MobileApp
    component [Store Web\nNestJS] as StoreWeb
}

' Spacing
MobileApp -[hidden]-- StoreWeb

' API Gateway Layer
component [API Gateway\nNginx] as Gateway

' Business Services Layer
rectangle "Business Services" {
    component [Catalog API\n.NET 9] as CatalogAPI
    component [Basket API\n.NET 9] as BasketAPI
    component [Ordering API\nNestJS] as OrderingAPI
    component [Subscription API\nNestJS] as SubscriptionAPI
}

' Spacing between services
CatalogAPI -[hidden]-- BasketAPI
BasketAPI -[hidden]-- OrderingAPI
OrderingAPI -[hidden]-- SubscriptionAPI

' Infrastructure Layer
rectangle "Infrastructure" {
    component [PostgreSQL\nDatabase] as Postgres
    component [Redis\nCache] as Redis
    component [RabbitMQ\nEvent Bus] as RabbitMQ
    component [Keycloak\nAuthentication] as Keycloak
}

' Spacing between infrastructure
Postgres -[hidden]-- Redis
Redis -[hidden]-- RabbitMQ
RabbitMQ -[hidden]-- Keycloak

' External Services
component [LiqPay\nPayment Gateway] as PaymentGW

' Client to Gateway
MobileApp --> Gateway : HTTPS
StoreWeb --> Gateway : HTTPS

' Gateway to Services
Gateway --> CatalogAPI : REST
Gateway --> BasketAPI : REST
Gateway --> OrderingAPI : REST
Gateway --> SubscriptionAPI : REST

' Services to Infrastructure (grouped by service)
CatalogAPI --> Postgres : Database
CatalogAPI --> RabbitMQ : Events
CatalogAPI --> Keycloak : Auth

BasketAPI --> Redis : Cache
BasketAPI --> RabbitMQ : Events
BasketAPI --> Keycloak : Auth

OrderingAPI --> Postgres : Database
OrderingAPI --> RabbitMQ : Events
OrderingAPI --> Keycloak : Auth
OrderingAPI --> PaymentGW : Payment

SubscriptionAPI --> Postgres : Database
SubscriptionAPI --> RabbitMQ : Events
SubscriptionAPI --> Keycloak : Auth

' Event-driven (async) - dotted lines
RabbitMQ ..> OrderingAPI : OrderCreated
RabbitMQ ..> BasketAPI : BasketEvents
RabbitMQ ..> SubscriptionAPI : SubscriptionEvents

' Notes (below components)
note bottom of Gateway
    **API Gateway:**
    Єдина точка входу,
    Load balancing,
    Authentication proxy
end note

note bottom of CatalogAPI
    **Catalog API:**
    Управління товарами,
    Пошук та фільтрація
end note

note bottom of BasketAPI
    **Basket API:**
    Кешовані операції,
    gRPC для швидкості
end note

note bottom of OrderingAPI
    **Ordering API:**
    Бізнес-логіка замовлень,
    Інтеграція з платежами
end note

note bottom of SubscriptionAPI
    **Subscription API:**
    Управління підписками,
    Автоматичні замовлення
end note

note bottom of RabbitMQ
    **Event Bus:**
    Асинхронна комунікація,
    Service decoupling
end note

@enduml
